# Copy to .env and fill in. Never commit .env.
# Use a Bluesky APP PASSWORD (Settings > Privacy and security > App passwords),
# never your main account password.
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# Jetstream replay (python -m collection.prevalence --since ...). Create a key at
# https://bsky.network/account#api-keys-section-heading
JETSTREAM_API_KEY=

# Optional overrides of config/settings.yaml
TARGET_COUNT=
MIN_MATCHES=
