# Copy to .env and fill in. Never commit .env.
# Source B only: use a Bluesky APP PASSWORD (Settings > Privacy and security > App passwords),
# never your main account password.
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# Optional overrides of config/settings.yaml
TARGET_COUNT=
MIN_MATCHES=
JETSTREAM_URL=
JETSTREAM_ENABLED=
SEARCH_ENABLED=
